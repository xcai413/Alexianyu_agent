Screen {
    layout: vertical;
}

#status-bar {
    height: 1;
    background: $panel;
    color: $text;
    padding: 0 1;
}

#risk-bar {
    height: 1;
    background: $error;
    color: $text;
    padding: 0 1;
}

#dashboard-grid {
    layout: grid;
    grid-size: 2 3;
    grid-rows: 1fr 1fr 1fr;
    grid-gutter: 1;
    padding: 0 1 1 1;
    height: 1fr;
}

#items-panel {
    column-span: 2;
}

DataTable {
    border: round $primary;
    height: 100%;
}

DataTable:focus {
    border: round $accent;
}

Footer {
    height: 1;
}

# ====== xianyu-agent 配置示例 ======
# 复制到 .env 后填入实际值;不要提交 .env 到 git

# === 运行时 ===
XIANYU_ENV=development                # development | production
XIANYU_DATA_DIR=./data                # SQLite、卡密、Cookie 存放目录
XIANYU_LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR
XIANYU_TZ=Asia/Shanghai

# === 数据库 ===
# 留空则用 $XIANYU_DATA_DIR/xianyu.db
XIANYU_DB_PATH=

# === 安全 ===
# Fernet 密钥,用于加密 Cookie / Token;首次启动会自动生成并写入 .env
XIANYU_FERNET_KEY=

# === HTTP API (可选,FastAPI) ===
XIANYU_HTTP_HOST=127.0.0.1
XIANYU_HTTP_PORT=8089

# === MCP Server ===
XIANYU_MCP_HOST=127.0.0.1
XIANYU_MCP_PORT=8090

# === 闲鱼协议 ===
# 实时推送 WebSocket 地址(真实服务;连接时带完整 Cookie header)
XIANYU_WS_URL=wss://wss-goofish.dingtalk.com/
XIANYU_MTOP_URL=

# === AI Provider (可选,Phase 7 填) ===
# OpenAI 兼容 API,留空则 AI 回复自动降级为纯规则回复
XIANYU_AI_BASE_URL=
XIANYU_AI_API_KEY=
XIANYU_AI_MODEL=

# === 回复模式 ===
# rule(默认,纯规则)| rule_then_ai(规则优先,未命中走 AI)| ai(AI 优先)
XIANYU_REPLY_MODE=rule

# === guardrails (可选) ===
XIANYU_GUARDRAIL_MAX_MSG_PER_HOUR=60
XIANYU_GUARDRAIL_MAX_ORDER_AMOUNT=9999
XIANYU_GUARDRAIL_QUIET_HOURS=23:00-08:00
XIANYU_GUARDRAIL_FAIL_THRESHOLD=5

# ====== xianyu-agent 配置示例 ======
# 复制到 .env 后填入实际值;不要提交 .env 到 git

# === 运行时 ===
XIANYU_ENV=development                # development | production
XIANYU_DATA_DIR=./data                # SQLite、卡密、Cookie 存放目录
XIANYU_LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR
XIANYU_TZ=Asia/Shanghai

# === 数据库 ===
# DATABASE_URL 非空时优先于 DB_PATH；SQLite/MySQL/PostgreSQL 都是一等支持。
# 可使用显式 async URL：
# XIANYU_DATABASE_URL=sqlite+aiosqlite:///./data/xianyu.db
# XIANYU_DATABASE_URL=mysql+asyncmy://user:password@127.0.0.1:3306/xianyu
# XIANYU_DATABASE_URL=postgresql+asyncpg://user:password@127.0.0.1:5432/xianyu
# 也可使用 bare sqlite/mysql/postgresql URL，程序会转换到默认 async driver。
XIANYU_DATABASE_URL=
# DATABASE_URL 留空时使用本地 SQLite；DB_PATH 留空则用 $XIANYU_DATA_DIR/xianyu.db。
XIANYU_DB_PATH=

# === 安全 ===
# Fernet 密钥,用于加密 Cookie / Token;首次启动会自动生成并写入 .env
XIANYU_FERNET_KEY=
# 可选的独立 SecretVault 主密钥,用于外部发货 API / AI Provider 密钥。
# 留空时兼容复用 XIANYU_FERNET_KEY;生产环境建议生成另一把 Fernet 密钥隔离。
XIANYU_SECRET_MASTER_KEY=
XIANYU_SECRET_MASTER_KEY_VERSION=v1

# === Web 运营后台(管理员单用户) ===
# 用 `xianyu-agent web password-hash` 生成，保留输出中的单引号，禁止填写密码明文。
XIANYU_WEB_ADMIN_PASSWORD_HASH=''
# 会话签名密钥；使用至少 32 位随机字符串，禁止提交真实值。
XIANYU_WEB_SESSION_SECRET=
XIANYU_WEB_SESSION_TTL_SECONDS=28800
# HTTPS 部署设为 true；本地 http 开发可保持 false。
XIANYU_WEB_COOKIE_SECURE=false

# === HTTP API (可选,FastAPI) ===
XIANYU_HTTP_HOST=127.0.0.1
XIANYU_HTTP_PORT=8089
XIANYU_HEALTH_SERVER_ENABLED=false

# === MCP Server ===
XIANYU_MCP_HOST=127.0.0.1
XIANYU_MCP_PORT=8090

# === 闲鱼协议 ===
# 实时推送 WebSocket 地址(真实服务;连接时带完整 Cookie header)
XIANYU_WS_URL=wss://wss-goofish.dingtalk.com/
XIANYU_MTOP_URL=

# === AI Provider (可选,Phase 7 填) ===
# OpenAI 兼容 API,留空则 AI 回复自动降级为纯规则回复
XIANYU_AI_BASE_URL=
XIANYU_AI_API_KEY=
XIANYU_AI_MODEL=

# === 回复模式 ===
# rule(默认,纯规则)| rule_then_ai(规则优先,未命中走 AI)| ai(AI 优先)
XIANYU_REPLY_MODE=rule
# observe(默认,只落库不自动操作)|active(启用规则回复和自动发货)
XIANYU_AUTOMATION_MODE=observe
XIANYU_PLATFORM_AUTOMATION_INTERVAL_SECONDS=30
# 可选运维告警:留空=不发任何外部通知。填 https 地址后,daemon 会把新出现的待人工处理事项推过去。
XIANYU_ALERT_WEBHOOK_URL=
XIANYU_ALERT_INTERVAL_SECONDS=60

# === 多副本账号接管 ===
# true 时,旧 owner 失效后的接管需先执行 pool takeover-approve。
XIANYU_TAKEOVER_REQUIRE_APPROVAL=false
XIANYU_TAKEOVER_MAX_FAILURES=3

# === guardrails (可选) ===
XIANYU_GUARDRAIL_MAX_MSG_PER_HOUR=60
XIANYU_GUARDRAIL_MAX_ORDER_AMOUNT=9999
XIANYU_GUARDRAIL_QUIET_HOURS=23:00-08:00
XIANYU_GUARDRAIL_FAIL_THRESHOLD=5
